# SmartCart Intelligence Environment Configuration Template
# Duplicate this file as '.env' for local development.

PROJECT_NAME="SmartCart Intelligence"
PROJECT_VERSION="1.0.0"

# Database Configuration
# Default is SQLite for zero-friction local development.
# To connect to PostgreSQL: postgresql://postgres:your_password@localhost:5432/smartcart
DATABASE_URL="sqlite:///./smartcart.db"

# Security & JWT Token Settings
SECRET_KEY="smartcart-super-secret-jwt-token-key-2026-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Delivery Configuration
# "MOCK" writes rendered HTML alerts to development outbox without sending external emails.
# "SMTP" delivers live emails via external provider.
EMAIL_DELIVERY_MODE="MOCK"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alerts@smartcart.ai"

# Background Scheduler & Cache Policies
PRICE_REFRESH_INTERVAL_MINUTES=30
CACHE_FRESHNESS_TTL_MINUTES=60

# Retailer Commercial API Credentials (Optional - certified sample mode active when empty)
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_PARTNER_TAG="smartcart-in-21"

FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

CROMA_PARTNER_API_KEY=""
RELIANCE_DIGITAL_API_TOKEN=""
TATACLIQ_API_KEY=""
